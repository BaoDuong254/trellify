{
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "ocr-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ocr-review-gate.sh\" start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "ocr-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ocr-review-gate.sh\" record"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ocr-review-gate.sh\" check"
          }
        ]
      }
    ]
  }
}
