{
  "name": "trellify",
  "version": "1.6.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "apps:build": "turbo run apps:build",
    "be": "pnpm --filter=server",
    "clean": "turbo run clean",
    "cz": "cz",
    "eslint": "pnpm --filter=eslint",
    "fe": "pnpm --filter=client",
    "format": "prettier --check --ignore-unknown .",
    "format:fix": "prettier --write --ignore-unknown .",
    "preinstall": "pnpm dlx only-allow pnpm",
    "k6": "node k6/tools/run.mjs",
    "k6:peak-rps": "node k6/tools/peak-rps.mjs",
    "k6:traffic-mix": "node k6/tools/traffic-mix.mjs",
    "k6:watch": "node k6/tools/watch-server.mjs",
    "knip": "knip",
    "knip:production": "knip --production",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "loadtest:clean": "dotenv -e k6/loadtest.env -o -- pnpm be exec tsx scripts/seed-loadtest.ts --cleanup",
    "loadtest:down": "docker compose -f docker-compose.loadtest.yml down -v --remove-orphans",
    "loadtest:down:multi": "docker compose -f docker-compose.loadtest.multi.yml down -v --remove-orphans",
    "loadtest:seed": "dotenv -e k6/loadtest.env -o -- pnpm be exec tsx scripts/seed-loadtest.ts",
    "loadtest:up": "docker compose -f docker-compose.loadtest.yml up -d --build --wait --remove-orphans",
    "loadtest:up:multi": "docker compose -f docker-compose.loadtest.multi.yml up -d --build --wait --remove-orphans",
    "ncu": "pnpm update --latest --workspace-root",
    "pkg:build": "turbo run pkg:build",
    "prepare": "node -e \"const cp=require('child_process');try{cp.execSync('git rev-parse --git-dir',{stdio:'ignore'});cp.execSync('lefthook install',{stdio:'inherit'})}catch(e){}\"",
    "shared": "pnpm --filter=shared",
    "start:dev": "turbo run start:dev start:worker:dev",
    "start:prod": "turbo run start:prod start:worker:prod",
    "typecheck": "turbo run typecheck",
    "ui": "pnpm --filter=ui"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@trivago/prettier-plugin-sort-imports": "catalog:",
    "@types/node": "catalog:",
    "@workspace/typescript": "workspace:*",
    "commitizen": "catalog:",
    "cz-git": "catalog:",
    "dotenv-cli": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "prettier-plugin-prisma": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "24.12.0",
    "pnpm": "11.5.2"
  }
}
