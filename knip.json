{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "ignore": [".claude/**", "k6/**"],
  "ignoreDependencies": ["eslint-import-resolver-typescript"],
  "workspaces": {
    ".": {
      "entry": ["unlighthouse.config.ts!"]
    },
    "apps/server": {
      "entry": ["src/index.ts!", "src/worker.ts!", "scripts/seed-loadtest.ts!"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts!", "test/**/*.ts"]
    },
    "apps/client": {
      "project": ["src/**/*.{ts,tsx}!", "!src/test/**!"]
    },
    "e2e": {
      "entry": ["tests/**/*.{e2e,setup}.ts"],
      "project": ["**/*.ts"]
    }
  }
}
