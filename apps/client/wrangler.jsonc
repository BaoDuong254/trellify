{
  "name": "trellify-client",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "routes": [
    {
      "pattern": "trellify.duonggiabao.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/diagnostics"],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "issues": {
      "enabled": true,
    },
  },
}
